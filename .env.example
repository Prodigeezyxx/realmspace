# Configuration for `docker compose up` (repo root).
#
# Copy to .env and fill both in. Neither has a default: compose refuses to start
# without them rather than inventing one, because a shipped default signing
# secret is a token anyone can forge.
#
# Generate a secret:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

JWT_SECRET=
NEO4J_PASSWORD=

# Note: backend/.env is a *different* file, for running the backend directly
# from a venv against the brew-installed databases. This one is only read by
# docker compose.
