# Connecting the dashboard to the realmspace backend.
#
# Copy these into .env.local alongside the Firebase keys (see firebase.env.example).
# Leave them out entirely and the dashboard runs self-contained on localStorage,
# which is what the laptop demo needs.

# The FastAPI backend. No trailing slash.
NEXT_PUBLIC_BUS_URL=http://localhost:8000

# Identity presented to the bus when nobody is signed in through Firebase.
# Matches what `python -m app.auth.seed` creates by default, so the two halves
# line up out of the box.
#
# Not a credential: the backend's POST /v1/auth/token currently trusts whatever
# email it is handed. Verifying the Firebase login is still open — see
# backend/README.md.
NEXT_PUBLIC_BUS_EMAIL=admin@floats.demo
