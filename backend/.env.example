# Copy to backend/.env and adjust. The real .env is gitignored.
#
# Homebrew Postgres creates a superuser named after your macOS user with trust
# auth over the local socket, so no password is needed locally.
# The app connects as realmspace_app — created by migration 0003, and neither a
# superuser nor an owner, so row-level security applies to it. A superuser
# bypasses policies unconditionally, so using one here would make the isolation
# decorative.
DATABASE_URL=postgresql+asyncpg://realmspace_app@localhost:5432/realmspace
TEST_DATABASE_URL=postgresql+asyncpg://realmspace_app@localhost:5432/realmspace_test

# Alembic only. Needs CREATE/ALTER, which the app deliberately does not have.
ADMIN_DATABASE_URL=postgresql+asyncpg://antoniorobles@localhost:5432/realmspace

# "local" on the edge box / your laptop, "cloud" when deployed.
ENV=local

# Neo4j holds the graph (data-model.md). Homebrew's neo4j starts with
# neo4j/neo4j and forces a password change on first connect:
#   cypher-shell -u neo4j -p neo4j -d system \
#     "ALTER CURRENT USER SET PASSWORD FROM 'neo4j' TO '<your-password>';"
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Auth. Tokens are signed and verified locally so the edge box works offline.
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
# No default is provided on purpose — a shipped default is a forgeable token.
JWT_SECRET=change-me-generate-a-real-one
JWT_TTL_SECONDS=3600

# Encrypts each tenant's CRM credential in `tenant_integration` (multi-tenant.md
# §2). Urlsafe base64 of 32 bytes:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Unset means storing a credential is refused, not stored in the clear — see
# app/secrets.py. Rotating this makes every stored credential undecryptable, so
# rotation means re-entering them; there is no re-encryption path yet.
CREDENTIAL_ENCRYPTION_KEY=
