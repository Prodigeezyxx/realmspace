# realmspace edge API — copy to .env and adjust
# Default: SQLite file under backend/data/
DATABASE_URL=sqlite:///./data/realmspace.db

# Optional Postgres:
# DATABASE_URL=postgresql://realmspace:realmspace@localhost:5432/realmspace

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
